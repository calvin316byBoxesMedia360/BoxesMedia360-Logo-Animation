# Environment Variables Template
# Plantilla de Variables de Entorno

# ============================================================================
# Google Cloud Configuration / Configuración de Google Cloud
# ============================================================================

# Your Google Cloud Project ID / Tu ID de Proyecto de Google Cloud
# Example / Ejemplo: computational-cinematography-12345
GOOGLE_CLOUD_PROJECT_ID=your-project-id
# Google Cloud Region / Región de Google Cloud
# Recommended / Recomendado: us-central1, us-east4, europe-west4
GOOGLE_CLOUD_REGION=us-central1

# ============================================================================
# Vertex AI Configuration / Configuración de Vertex AI
# ============================================================================

# Veo Model Version / Versión del Modelo Veo
# Options / Opciones: veo-2.0, veo-3.1
VERTEX_AI_MODEL=veo-3.1

# Vertex AI API Endpoint / Endpoint de API de Vertex AI
# Auto-generated from region if not specified / Auto-generado desde región si no se especifica
# VERTEX_AI_API_ENDPOINT=https://us-central1-aiplatform.googleapis.com

# ============================================================================
# Authentication / Autenticación
# ============================================================================

# Path to service account key file / Ruta al archivo de clave de cuenta de servicio
# Example / Ejemplo: ./vertex-ai-key.json
# GOOGLE_APPLICATION_CREDENTIALS=./vertex-ai-key.json

# Alternative: Use user account authentication / Alternativa: Usar autenticación de cuenta de usuario
# Uncomment if using gcloud auth / Descomentar si usas gcloud auth
# GOOGLE_AUTH_TYPE=user

# For testing: Direct auth token / Para pruebas: Token de autenticación directo
# Get with: gcloud auth print-access-token / Obtener con: gcloud auth print-access-token
# GOOGLE_AUTH_TOKEN=your-token-here

# ============================================================================
# Performance Settings / Configuración de Rendimiento
# ============================================================================

# Maximum concurrent render jobs / Máximo de trabajos de renderizado concurrentes
MAX_CONCURRENT_RENDERS=2

# Render timeout in milliseconds / Timeout de renderizado en milisegundos
# Default: 5 minutes / Por defecto: 5 minutos
RENDER_TIMEOUT_MS=300000

# Maximum concurrent Vertex AI requests / Máximo de solicitudes concurrentes a Vertex AI
MAX_CONCURRENT_API_REQUESTS=3

# ============================================================================
# Output Configuration / Configuración de Salida
# ============================================================================

# Output directory for rendered videos / Directorio de salida para videos renderizados
OUTPUT_DIR=./out

# Default FPS for compositions / FPS por defecto para composiciones
DEFAULT_FPS=30

# Default resolution / Resolución por defecto
# Options / Opciones: 720p, 1080p, 4k
DEFAULT_RESOLUTION=1080p

# ============================================================================
# Logging and Learning / Logging y Aprendizaje
# ============================================================================

# Enable detailed logging / Habilitar logging detallado
ENABLE_DETAILED_LOGGING=true

# Log level / Nivel de log
# Options / Opciones: debug, info, warn, error
LOG_LEVEL=info

# Enable learning system / Habilitar sistema de aprendizaje
ENABLE_LEARNING_SYSTEM=true

# ============================================================================
# Development Settings / Configuración de Desarrollo
# ============================================================================

# Development mode / Modo de desarrollo
NODE_ENV=development

# Port for Remotion Studio / Puerto para Remotion Studio
PORT=3000

# Enable hot reload / Habilitar recarga en caliente
ENABLE_HOT_RELOAD=true

# ============================================================================
# GitHub Actions Configuration / Configuración de GitHub Actions
# ============================================================================

# GitHub Repository (formato: usuario/repositorio)
# Example / Ejemplo: calvin316byBoxesMedia360/Digital-Menu-Studio-Pro
VITE_GITHUB_REPO=calvin316byBoxesMedia360/Digital-Menu-Studio-Pro

# GitHub Personal Access Token
# Create one at / Crear uno en: https://github.com/settings/tokens
VITE_GITHUB_TOKEN=your-github-token
